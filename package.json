{
  "name": "@tplnet/homebridge-denon-heos-audio",
  "displayName": "Homebridge Denon Heos Audio (tplnet)",
  "type": "module",
  "version": "1.0.0-beta.1-tplnet.7",
  "description": "Control your Denon and Marantz HEOS speakers, amplifiers and AVRs via AVR Control and/or HEOS CLI",
  "author": "tplnet",
  "contributors": [
    "hov3rcraft (original author, https://github.com/hov3rcraft)"
  ],
  "license": "MIT",
  "homepage": "https://github.com/tplnet/homebridge-denon-heos-audio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tplnet/homebridge-denon-heos-audio.git"
  },
  "bugs": {
    "url": "https://github.com/tplnet/homebridge-denon-heos-audio/issues"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "denon",
    "marantz",
    "heos",
    "avr",
    "speaker",
    "ceol",
    "avrcontrol",
    "heoscli",
    "heos-cli"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.1.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "prepare": "npm run build",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build && node --test \"test/unit/**/*.test.js\"",
    "smoke": "npm run build && node scripts/smoke-test.mjs",
    "check": "npm audit && npm run lint && npm test && node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.8.6",
    "eslint": "^9.14.0",
    "homebridge": "^2.5.0",
    "nodemon": "^3.1.7",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "async-mutex": "^0.5.0",
    "date-fns": "^4.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "nodemon": {
      "minimatch": "^11.0.8"
    }
  }
}
