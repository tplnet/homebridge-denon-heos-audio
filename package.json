{
  "name": "@tplnet/homebridge-heos-multiroom-audio",
  "displayName": "Homebridge HEOS Multiroom-Audio (tplnet)",
  "type": "module",
  "version": "1.5.1-beta.7",
  "description": "HEOS multiroom audio in Apple Home: Denon and Marantz HEOS speakers, amplifiers and AV receivers (Denon Home, Home Amp, Marantz Cinema, Denon AVR, CEOL). Power, volume, inputs, play/pause, automatic discovery.",
  "author": "tplnet",
  "contributors": [
    "hov3rcraft (original author, https://github.com/hov3rcraft)"
  ],
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/tplnet/homebridge-heos-multiroom-audio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tplnet/homebridge-heos-multiroom-audio.git"
  },
  "bugs": {
    "url": "https://github.com/tplnet/homebridge-heos-multiroom-audio/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "heos",
    "heos-multiroom",
    "multiroom",
    "multi-room",
    "multiroom-audio",
    "denon",
    "marantz",
    "denon-heos",
    "marantz-heos",
    "denon-home",
    "home-amp",
    "marantz-cinema",
    "denon-avr",
    "marantz-avr",
    "avr",
    "av-receiver",
    "receiver",
    "amplifier",
    "speaker",
    "soundbar",
    "ceol",
    "music",
    "audio",
    "apple-home",
    "homekit",
    "siri",
    "tv",
    "avrcontrol",
    "heoscli",
    "heos-cli"
  ],
  "main": "dist/index.js",
  "directories": {
    "schemas": "schemas"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "config.schema.json",
    "schemas/*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.1.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "prepare": "npm run build",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build && node --test \"test/unit/**/*.test.js\"",
    "smoke": "npm run build && node scripts/smoke-test.mjs",
    "check": "npm audit --omit=dev --audit-level=low && npm run lint && npm test && node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run lint && npm test",
    "watch": "npm run build && npm link && nodemon",
    "preversion": "npm run check",
    "version": "node scripts/release-notes.mjs > /dev/null",
    "postversion": "git push --follow-tags",
    "malware": "node scripts/malware-scan.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.8.6",
    "eslint": "^9.14.0",
    "homebridge": "^2.5.0",
    "nodemon": "^3.1.7",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "async-mutex": "^0.5.0",
    "date-fns": "^4.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "nodemon": {
      "minimatch": "^11.0.8"
    }
  }
}
